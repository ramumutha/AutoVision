# Sprint 0 local development placeholders
# Copy to .env and set a strong password before running compose.
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql+psycopg://autovision:change-me-strong-password@localhost:5432/autovision
TEST_DATABASE_URL=postgresql+psycopg://autovision:change-me-strong-password@localhost:5432/autovision_test
CORS_ALLOWED_ORIGINS=http://localhost:3000
EVIDENCE_STORAGE_PROVIDER=local
EVIDENCE_LOCAL_STORAGE_ROOT=./var/evidence
EVIDENCE_MAX_FILE_SIZE_BYTES=26214400
KEYCLOAK_ADMIN_PASSWORD=change-me-local-admin-password
AUTOVISION_PLATFORM_CLIENT_SECRET=change-me-local-client-secret
AUTOVISION_PLATFORM_DATABASE_URL=jdbc:postgresql://localhost:5432/autovision
AUTOVISION_PLATFORM_DATABASE_USERNAME=autovision
AUTOVISION_PLATFORM_DATABASE_PASSWORD=change-me-local-platform-db-password
# Local browser proof fixture; set real values only in ignored .env.
AUTOVISION_LOCAL_DEV_USERNAME=autovision-local
AUTOVISION_LOCAL_DEV_PASSWORD=change-me-local-dev-password
AUTOVISION_LOCAL_DEV_USER_REF_ID=00000000-0000-0000-0000-000000000000
AUTOVISION_LOCAL_DEV_TENANT_ID=00000000-0000-0000-0000-000000000000