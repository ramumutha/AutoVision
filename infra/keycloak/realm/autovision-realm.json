{
  "realm": "autovision",
  "enabled": true,
  "displayName": "AutoVision",
  "clients": [
    {
      "clientId": "autovision-platform",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "${AUTOVISION_PLATFORM_CLIENT_SECRET}",
      "protocolMappers": [
        {
          "name": "autovision-user-ref-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "autovision_user_ref_id",
            "claim.name": "autovision_user_ref_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false"
          }
        }
      ]
    },
    {
      "clientId": "autovision-web",
      "name": "AutoVision Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8080/*",
        "http://127.0.0.1:8080/*",
        "http://localhost:4200/*",
        "http://127.0.0.1:4200/*"
      ],
      "webOrigins": [
        "http://localhost:8080",
        "http://127.0.0.1:8080",
        "http://localhost:4200",
        "http://127.0.0.1:4200"
      ],
      "protocolMappers": [
        {
          "name": "autovision-user-ref-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "autovision_user_ref_id",
            "claim.name": "autovision_user_ref_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false"
          }
        }
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
  "userProfile": {
    "attributes": [
      {
        "name": "autovision_user_ref_id",
        "displayName": "AutoVision User Reference ID",
        "group": "user-metadata",
        "validations": {
          "length": {
            "min": 36,
            "max": 36
          }
        },
        "permissions": {
          "view": [
            "admin"
          ],
          "edit": [
            "admin"
          ]
        },
        "multivalued": false
      }
    ],
    "groups": [
      {
        "name": "user-metadata",
        "displayHeader": "User metadata",
        "displayDescription": "Attributes, which refer to user metadata"
      }
    ]
  }
}